def sort_aplha(string):
    li = sorted(list(string))
    lower_li = sorted(list(string.lower()))
    caps = []
    new_letter = ''
    for i in li:
        if i.isupper():
            caps.append(i)
    for i in lower_li:
        if caps.count(i.upper())!=0:
            new_letter+=i.upper()
            caps.pop(caps.index(i.upper()))
        else:
            new_letter +=i
    return new_letter
