def sieve_of_eratosthenes(limit):
    prime_flags = [True] * (limit + 1)
    p = 2
    while p * p <= limit:
        if prime_flags[p]:
            for i in range(p * p, limit + 1, p):
                prime_flags[i] = False
        p += 1

    primes = [p for p in range(2, limit) if prime_flags[p]]
    return primes

