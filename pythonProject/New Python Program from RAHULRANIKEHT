def binary_search(li,element):
    bottom = 0 
    top  = len(li)-1
    index = -1
    
    while top>=bottom and index==-1:
        mid = int(math.floor((top+bottom)/2))
        if li[mid]==element:
            index = mid 
            
        elif li[mid]>element:
            top = mid-1
        else:
            bottom = mid+1
    return index
