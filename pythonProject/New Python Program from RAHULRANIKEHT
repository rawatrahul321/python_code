def are_parentheses_balanced(s):
    stack = []
    mapping = {")": "(", "}": "{", "]": "["}

    for char in s:
        if char in mapping:  # if the character is a closing bracket
            # pop the topmost element from the stack, if the stack is not empty
            # otherwise assign a dummy value like '#'
            top_element = stack.pop() if stack else '#'

            # check if the popped element matches the corresponding opening bracket
            if mapping[char] != top_element:
                return False
        else:
            stack.append(char)

    # if the stack is empty, then all brackets were matched and balanced
    return not stack

