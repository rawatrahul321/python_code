Two Sum when the element is sorted Array:- 

nums = [1,2,3,4,5,6,7,10,11]
target = 9
def two_sum_binary(nums,target):
    left,right = 0,len(nums)-1
    while(left<right):
        curretSum = nums[left]+nums[right]
        if curretSum > target:
            right -=1
        elif curretSum < target:
            left +=1
        else:
            return [left+1,right+1]
    return []
print(two_sum_binary(nums,target))


