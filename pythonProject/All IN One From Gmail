def is_balanced(s):
    stack = []
    mapping = {')': '(', '}': '{', ']': '['}
    for i in s:
        if i in mapping:
            top = stack.pop() if stack else ''
            if mapping[i]!=top:
                return False
        else:
            stack.append(i)
    return not stack
print(is_balanced("({[]})"))   # True
print(is_balanced("({[})"))    # False
print(is_balanced("((()))")) 

