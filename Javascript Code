// Async / Await 
datas = [{'name':'rahul','profession':'SE'},
{'name':'deepak','profession':'EE'}]

function getData(){
    let output  = '';
    datas.forEach((data,index)=>{
      output+= `<li>${data.name}</li>`
    })
    document.write(output)
}

function createData(newdata){
  return new Promise((resolve,reject)=>{
    datas.push(newdata);
    let error= false;
    if (!error){
      resolve();
    }
    else{
      reject();
    }
  })

}
async function start(){
   await createData({'name':'vinod','profession':'DE'})
getData()
}
start()



