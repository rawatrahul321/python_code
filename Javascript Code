// reduce 
let arr = [12,3,4,34,2,3,4]
let unique_num=(arr)=>{
  return arr.reduce((acc,ele)=> {
    return acc.includes(ele) ? acc : [...acc,ele]
  },[])
}
console.log(unique_num(arr))

